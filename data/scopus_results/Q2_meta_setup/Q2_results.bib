@ARTICLE{Rahmani202555,
	author = {Rahmani, Arsalan and Hosseini, Meysam and Sahami, Amir},
	title = {Two-stage stochastic capacitated Lot-Sizing problem by Lot-Size adaptation approach},
	year = {2025},
	journal = {AUT Journal of Mathematics and Computing},
	volume = {6},
	number = {1},
	pages = {55 - 66},
	doi = {10.22060/AJMC.2023.22698.1184},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218039096&doi=10.22060%2FAJMC.2023.22698.1184&partnerID=40&md5=2e10e2682d5b340171c6337841313273},
	affiliations = {University of Kurdistan, Department of Mathematics, Sanandaj, Kurdistan, Iran; University of Kurdistan, Department of Mathematics, Sanandaj, Kurdistan, Iran; Ilam University, Department of Mathematics, Ilam, Ilam, Iran},
	abstract = {In this paper, a two-stage stochastic capacitated lot-sizing problem with random demand, and service level constraints under static and static-dynamic uncertainty strategies is introduced. A static strategy determines the setup period and lot sizing at the beginning of planning period, whereas a static-dynamic strategy allows the lot size to be adjusted during the planning period. A new model formulation of the demand differential adjustment policy in a multi-stage production system is proposed. Lot-sizing adjustments depend on the difference in demand between actual and expected demand. To quantify the economics of our uncertainty strategy for multi-level lot size the problems, the number of test instances with different parameter settings is evaluated. Computational experiments show that the additional costs of semi-finished products, and the lack of storage capacity in the downstream processes reduce the potential for cost savings via multi-volume reform. Also a robust model is developed and as the robust model under study is NP-hard, it solved by a hybrid heuristic using the proposed stochastic model, a robust model is developed, which is solved by a hybrid heuristic algorithm based on Lagrangian relaxation and Bender’s decomposition algorithms. To evaluate the convergence rate and solution quality, the method is applied to some random test instances generated in the literature. The computational results indicate that the proposed method is capable of efficiently solving the model. © 2025 The Author(s).},
	author_keywords = {Benders decomposition; Inventory systems; Lagrangian relaxation; Productive planning; Robust model; Two-stage stochastic programming},
	correspondence_address = {A. Rahmani; Department of Mathematics, University of Kurdistan, Sanandaj, Iran; email: a.rahmani@uok.ac.ir},
	publisher = {Amirkabir University of Technology},
	issn = {27832449},
	language = {English},
	abbrev_source_title = {AUT J. Math. Comput.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; Conference name: null; Conference sponsors: ; Conference code: null; Conference date: }
}

@ARTICLE{Stanković2025206,
	author = {Stanković, Aleksandar and Simić, Nikola and Stanković, Milica},
	title = {Metaheuristic Optimization for Stochastic Job Scheduling in Parallel Machine Systems with Uncertain Processing and Setup Times},
	year = {2025},
	journal = {Journal of Engineering Management and Systems Engineering},
	volume = {4},
	number = {3},
	pages = {206 - 217},
	doi = {10.56578/jemse040304},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105026177318&doi=10.56578%2Fjemse040304&partnerID=40&md5=2c099e60f2b6957063f5338028ba3f1f},
	affiliations = {University of Niš, Faculty of Mechanical Engineering, Nis, Serbia; University of Kragujevac, Faculty of Engineering, Kragujevac, Serbia; University of Niš, Faculty of Economics, Nis, Serbia},
	abstract = {The problem of job scheduling in parallel machine environments, where both processing times and setup times are characterized by stochastic variability, has been investigated with a focus on enhancing the efficiency of resource allocation in complex production systems. Job scheduling, as a critical component of operations research and systems engineering, plays a vital role in the optimization of large-scale, flexible manufacturing and service environments. In this study, a stochastic scheduling model has been formulated to minimize the maximum completion time (denoted as Ct<inf>max</inf>), under the simultaneous influence of probabilistic job durations and setup times associated with tool preparation. The problem has been addressed using two prominent metaheuristic algorithms: Genetic Algorithm (GA) and Simulated Annealing (SA). These methods were selected due to their demonstrated capacity to navigate large, non-deterministic search spaces efficiently and their adaptability to multi-constraint scheduling problems. A comparative analysis has been conducted by applying both algorithms under identical initial conditions, with algorithmic performance evaluated in terms of solution quality, computational efficiency, and robustness to input variability. The model incorporates key practical considerations, including randomized setup times which are often neglected in conventional deterministic scheduling models, thereby improving its relevance to real-world industrial settings. The formulation of the problem allows for additional constraints and objectives to be flexibly integrated in future research, including resource conflicts, machine eligibility constraints, and energy-aware scheduling. Empirical results suggest that while both algorithms are effective in deriving near-optimal schedules, notable differences exist in convergence behavior and sensitivity to parameter tuning. The findings offer critical insights into the comparative strengths of GA and SA in managing the stochastic nature of parallel machine scheduling problems. By advancing a robust metaheuristic framework that accounts for real-world uncertainties, this study contributes to the ongoing development of intelligent scheduling systems in systems engineering, manufacturing logistics, and automated production planning. © 2025 by the author(s). Licensee Acadlore Publishing Services Limited, Hong Kong.},
	author_keywords = {Genetic Algorithm (GA); Metaheuristic optimization; Parallel machine scheduling; Resource allocation; Simulated Annealing (SA); Stochastic processing times; Stochastic setup times; Systems engineering},
	correspondence_address = {A. Stanković; Faculty of Mechanical Engineering, University of Niš, Niš, 18000, Serbia; email: aleksandar.stankovic@masfak.ni.ac.rs},
	publisher = {Acadlore Publishing Services Limited},
	issn = {29583519},
	language = {English},
	abbrev_source_title = {J. eng. manag. syst. egn},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; Conference name: null; Conference sponsors: ; Conference code: null; Conference date: ; All Open Access; Hybrid Gold Open Access}
}

