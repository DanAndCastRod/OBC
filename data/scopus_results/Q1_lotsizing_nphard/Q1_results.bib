}

@CONFERENCE{Cortés-Fibla2015,
	author = {Cortés-Fibla, Raúl and Vidal-Carreras, Pilar Isabel and Garcia-Sabater, Jose P.},
	title = {Considering product dimensionality and utilization rates on the performance of different production strategies for the economic lot scheduling problem},
	year = {2015},
	journal = {Proceedings - CIE 45: 2015 International Conference on Computers and Industrial Engineering},
	pages = {},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84963644391&partnerID=40&md5=0a8dae73598770c899a3193b5a8898d8},
	affiliations = {Universitat Politècnica de València, Departmento de Organización de Empresas, Valencia, Valencia, Spain; Universitat Politècnica de València, Grupo de Investigación AERT, Valencia, Valencia, Spain},
	abstract = {We consider the problem of scheduling the production of multiple products on a single facility with limited production capacity, in literature known as Economic Lot Scheduling Problem (ELSP). In this work we compare the performance of four different production strategies for the ELSP under different stationary stochastic demand patterns. The performance, related to total inventory and setup costs, of different approaches to this problem is clearly dependent upon the production environment. We focus on utilization rates, as one of the most important parameters affecting this environment and analyze through a simulation study the effect of dimensionality on utilization rates, at different utilization levels. The results of our study confirm that the performance of a production strategy is strongly dependent on the dimensionality of utilization rates. Therefore, this effect raises the need for a sensitivity analysis to evaluate the impact of the particular value of these and other parameters on the performance of the production strategies for the ELSP.},
	author_keywords = {Complexity; ELSP; Lot sizing; Scheduling; Uncertainty},
	keywords = {Operations research; Sensitivity analysis; Stochastic systems; Complexity; Economic lot scheduling problems; ELSP; Lot sizing; Production capacity; Production environments; Production strategy; Uncertainty; Scheduling},
	correspondence_address = {R. Cortés-Fibla; Departmento de Organización de Empresas, Universitat Politécnica de Valencia, Valencia, Spain; email: racorfi@omp.upv.es},
	editor = {Kacem, I.},
	publisher = {Universite de Lorraine},
	language = {English},
