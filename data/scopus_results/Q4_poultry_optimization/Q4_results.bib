@ARTICLE{Abdelaziz2023,
	author = {Abdelaziz, Khaled I. and Singh, Mankerat and Sharif, Shayan and Sharma, Shreeya and Kulkarni, Raveendra R. and Alizadeh, Mohammadali and Yitbarek, Alexander and Helmy, Yosra A.},
	title = {Intervention Strategies to Control Campylobacter at Different Stages of the Food Chain},
	year = {2023},
	journal = {Microorganisms},
