	author = {Liu, Mingchang and Lin, Jihong and Liu, Zheshuo and Yang, Yange and Wang, Hongyue and Zhang, Feng and Wu, Yajun},
	title = {Identification of Meat by Rapid Evaporation Ionization Mass Spectrometry (REIMS); 快速蒸发电离质谱技术(REIMS)鉴别肉品},
