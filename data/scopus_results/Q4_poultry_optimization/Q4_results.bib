	title = {Designing a resilient-sustainable integrated broiler supply chain network using multiple sourcing and backup facility strategies dealing with uncertainties in a disruptive network: A real case of a chicken meat network},
	year = {2024},
	journal = {Computers and Chemical Engineering},
