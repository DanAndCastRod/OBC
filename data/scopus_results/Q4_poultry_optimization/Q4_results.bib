	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; Conference name: null; Conference sponsors: ; Conference code: null; Conference date: ; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access}
}

