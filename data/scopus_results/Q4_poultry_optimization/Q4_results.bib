	title = {Logistics and CO2e emissions from beef cattle transportation in Brazil between 2018 and 2020},
	year = {2025},
	journal = {Scientific Reports},
	volume = {15},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-025-21931-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020451051&doi=10.1038%2Fs41598-025-21931-5&partnerID=40&md5=c052ad22856c2818700657dda4a97601},
	affiliations = {Universidade de São Paulo, Faculty of Animal Science and Food Engineering, Sao Paulo, SP, Brazil; Universidade Estadual de Montes Claros, Department of Agricultural Sciences, Montes Claros, MG, Brazil; Universidade Federal do Pará, Institute of Veterinary Medicine, Belem, PA, Brazil; University of Wisconsin-Madison, Madison, WI, United States},
	abstract = {This study analysed the logistics of beef cattle transportation in Brazil from 2018 to 2020, based on 288,267 freight orders involving over 19 million animals from 42,805 farms and 38 slaughterhouses in ten states. The analysis included vehicle categorization, travel distances, carcass weights, available space per animal, and CO<inf>2</inf> equivalent (CO2e) emissions, which amounted to approximately 87,000 tonnes across 244,394 valid records. We hypothesized that emissions would vary substantially by truck class and transport conditions. Given that the median one-way transport distance was 160 km, all emission estimates were calculated for a 320 km round trip to reflect the full journey. Small trucks (up to 18 animals) were the most frequently used but also the least efficient; emissions for this class reached a median of 56.89 kg per ton of carcass and 13.99 kg per animal, with 75th percentiles as high as 98 kg/ton. In contrast, the Trailer54 class showed the highest efficiency, with a median of 37.77 kg/ton of carcass (IQR: 20.5–62.5). Across all classes, the wide gaps between the 25th and 75th percentiles point to substantial room for optimization. Emission intensity also varied between and within states, with median values per animal ranging from 8.74 kg in Minas Gerais to 17.31 kg in Rondônia. Intra-state variability was also considerable, as indicated by the wide interquartile ranges. Although emissions from livestock transport represent a small fraction of Brazil’s total GHG inventory, their spatial variability and operational inefficiencies make them strategically relevant for climate and logistics policy. These findings underscore the importance of region-specific strategies, fleet modernization, and improved logistical planning to support low-carbon beef supply chains. © The Author(s) 2025.},
	keywords = {carbon dioxide; animal; bovine; Brazil; exhaust gas; slaughterhouse; traffic and transport; Abattoirs; Animals; Carbon Dioxide; Cattle; Transportation; Vehicle Emissions},
	correspondence_address = {F.M.G.N. Dias; School of Animal Science and Food Engineering, University of São Paulo, São Paulo, SP, Brazil; email: fmgndias@usp.br},
	publisher = {Nature Research},
	pmid = {41168359},
	language = {English},
	abbrev_source_title = {Sci. Rep.},
	type = {Article},
