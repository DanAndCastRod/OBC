	keywords = {Authentication; Benchmarking; Data acquisition; Discriminant analysis; Evaporation; Factor analysis; Food supply; Ion chromatography; Ionization; Mass spectrometry; Meats; Phospholipids; Signal to noise ratio; Supply chains; Discriminative models; Identification and evaluation; Ionization mass spectrometry; Key performance indicators; Linear discriminant analysis; Parameter optimization; Phosphatidylglycerols; Quantitative research; Agriculture},
	correspondence_address = {Y.-J. Wu; Chinese Academy of Inspection and Quarantine, Beijing, 100176, China; email: wuyajuncaiq@163.com},
