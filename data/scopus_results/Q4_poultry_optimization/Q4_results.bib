@ARTICLE{Faisal2024,
	author = {Faisal, Marwa and Jacobson, Tomas and Meinert, Lene and Vorup, Peter and Bordallo, Heloisa N. and Kirkensgaard, Jacob Judas Kain and Ulvskov, Peter and Blennow, Andreas},
	title = {Development of pH Indicator Composite Films Based on Anthocyanins and Neutral Red for Monitoring Minced Meat and Fish in Modified Gas Atmosphere (MAP)},
	year = {2024},
	journal = {Coatings},
	volume = {14},
	number = {6},
