	affiliations = {Universiti Teknologi PETRONAS, Department of Chemical Engineering, Seri Iskandar, Perak, Malaysia; Universiti Teknologi PETRONAS, HICoE-Centre for Biofuel and Biochemical Research, Seri Iskandar, Perak, Malaysia; Universiti Teknologi PETRONAS, Department of Science, Seri Iskandar, Perak, Malaysia; Universiti Teknologi PETRONAS, Department of Civil & Environmental Engineering, Seri Iskandar, Perak, Malaysia; Universiti Teknologi PETRONAS, Centre for Urban Resource Sustainability, Seri Iskandar, Perak, Malaysia; Xiamen University Malaysia, School of Energy and Chemical Engineering, Sepang, Selangor, Malaysia; Curtin University, Malaysia, Department of Chemical Engineering, Miri, Sarawak, Malaysia; Curtin University, Malaysia, Centre of New and Sustainable Energy Research and Ventures (CoNSERV), Miri, Sarawak, Malaysia; Universiti Teknologi Malaysia Kuala Lumpur, Department of Chemical and Environmental Engineering, Kuala Lumpur, Malaysia; Universiti Tenaga Nasional, Kajang, Selangor, Malaysia},
	abstract = {Conventional biocomposite formulations are often constrained by the high cost and limited renewability of synthetic or inorganic fillers. Microalgae biomass residue (MBR) offers a sustainable alternative owing to its abundant post-extraction availability and its hydrophilic composition that enhances interfacial compatibility, mechanical strength, biodegradability. In this study, lipid-extracted Chlorella vulgaris biomass cultivated in poultry compost was uniquely incorporated into poly(lactic acid)/poly(butylene succinate) (PLA/PBS) blends alongside the use of triethyl citrate (TEC) as a plasticizer through melt blending to develop biocomposites and their structure–property relationships across varying MBR loadings. Fourier transform-infrared (FT-IR) spectroscopy confirmed good molecular compatibility, while X-ray diffraction (XRD) revealed a 30.8 % increase in crystallinity and uniform filler dispersion at 2 wt% MBR loading. Thermal analysis showed a marginal improvement in stability with MBR inclusion. Mechanical testing demonstrated that the 3 wt% MBR composite exhibited 7.3 % higher tensile strength and a 117.6 % increase in flexural modulus compared to the neat PLA/PBS blend, whereas higher loading (5 wt%) caused agglomeration and reduced integrity. Morphological analysis supported these findings, showing strong filler–matrix bonding at low MBR contents. Overall, optimized MBR loading (3 wt%) yielded the most balanced structural, mechanical, and thermal performance, establishing MBR as a promising green reinforcement for durable and high-performance biocomposites, which exhibit strong potential for eco-friendly packaging and lightweight structural applications. By repurposing defatted C. vulgaris biomass, a co-product of biofuel production, into a high-value material, this work exemplifies waste valorization within a circular bioeconomy framework, linking sustainable materials engineering with microalgal biorefinery innovation. © 2025 Elsevier B.V.},
	author_keywords = {Biocomposites; Biomanufacturing; Biorefinery; Circular Bioeconomy; Microalgal Biotechnology; Sustainability},
	correspondence_address = {M.K. Lam; Chemical Engineering Department, Universiti Teknologi PETRONAS, 32610 Seri Iskandar, Perak, Malaysia; email: lam.mankee@utp.edu.my},
