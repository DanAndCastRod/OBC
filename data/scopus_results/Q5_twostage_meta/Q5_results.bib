	doi = {10.1109/NetCIT54147.2021.00009},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85127589801&doi=10.1109%2FNetCIT54147.2021.00009&partnerID=40&md5=707973489a3ab3468b404ad2fbd9f6b3},
