	title = {Reliability-aware and Cost-efficient Planning Methods for Hydrogen-based Multi-energy Systems in Off-grid Mode},
	year = {2024},
	journal = {Proceedings - 2024 China Automation Congress, CAC 2024},
	pages = {2529 - 2534},
	doi = {10.1109/CAC63892.2024.10864709},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000792895&doi=10.1109%2FCAC63892.2024.10864709&partnerID=40&md5=1b8803c95a29a5cdafa80d03c396bf5f},
	affiliations = {Nanjing University of Post and TeleCommunications, College of Auto. & AI, Nanjing, Jiangsu, China},
	abstract = {Hydrogen-based multi-energy systems (HMESs) contribute to addressing the environmental and energy issues faced by many nations. When designing an HMES with higher reliability and lower system cost, system planning should be conducted beforehand. In this paper, we investigate an optimal planning problem for HMESs in off-grid mode under multi-source uncertainties. Specifically, we first formulate a multi-objective stochastic programming problem related to system cost and reliability. Then, we design a planning method for the considered HMES based on the third-generation non-dominated sorting genetic algorithm (NSGA-III) and a rule-based scheme. Finally, simulation results verify the effectiveness of the proposed method. Compared with several benchmarks, the proposed method can offer a better Pareto frontier (i.e., higher reliability and lower total cost can be implemented simultaneously). © 2024 IEEE.},
