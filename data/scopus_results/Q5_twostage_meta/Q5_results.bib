	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 38; All Open Access; Green Accepted Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Najafi20241316,
	author = {Najafi, Mehrnaz and Ghodratnama, Ali and Hanzalek, Zdenek and Tavakkoli–Moghaddam, Reza and Rohaninejad, Mohammad},
	title = {AN ECONOMIC PRODUCTION QUANTITY MODEL WITH QUANTITY DISCOUNTS, REWORK, AND PROCESS INTERRUPTIONS FOR SEVERAL ITEMS ON A SINGLE-MACHINE ENVIRONMENT},
	year = {2024},
	journal = {Proceedings of International Conference on Computers and Industrial Engineering, CIE},
