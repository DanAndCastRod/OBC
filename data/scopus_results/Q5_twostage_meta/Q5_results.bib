	title = {Optimal Control for Stochastic Multi-agent Systems With the Use of Parallel Hybrid Genetic Algorithm},
	year = {2025},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {14476 LNCS},
	pages = {273 - 280},
	doi = {10.1007/978-3-031-81241-5_19},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215663552&doi=10.1007%2F978-3-031-81241-5_19&partnerID=40&md5=4e5ea8856aa51a222eb28e91aa4b7288},
	affiliations = {Central Economic and Mathematics Institute, Russian Academy of Sciences, Moscow, Russian Federation; Moscow Institute of Physics and Technology, Dolgoprudny, Moscow Oblast, Russian Federation; HSE University, Moscow, Russian Federation},
	abstract = {In modern times, stochastic large-scale multi-agent systems (MAS) aimed at supporting socio-economic planning are being developed. There is a well known problem of a high computational complexity task of an optimal control for multiple agents’ behaviour in models of random interactions. In particular, agents (such as sellers and buyers) should make individualised decisions on establishing interconnections to exchange products, money or information at each moment of time. Such decisions affect the values of agents’ utility functions that, as a rule, should be maximised. In fact, each agent forms the set of individual states that define whether or not the interaction with other agents is allowed at moments of time. As a result, the dynamic programming method should be applied at the individual level of each agent maximising its own utility function, that is the extremely complex task. To overcome appropriate difficulties and seek suboptimal individual decisions in such MAS, a novel parallel hybrid real-coded genetic algorithm has been developed. The proposed hybrid method combines the use of the real-coded genetic algorithm (RCGA) for an evolutionary search, particle swarm optimisation for reducing the necessary number of model recalculations and periodically engaging ANN-based surrogate models for the fitness-function approximation. The approach allows researchers to significantly improve the time-efficiency of seeking optimal individualised decisions in MAS while keeping up their quality. Moreover, the distribution type can be one of the decision variables used in RCGAs for maximising the utility function. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {hybrid genetic algorithms; multi-agent systems; Optimal control; particle swarm optimisation},
	keywords = {Dynamic programming; Genetic programming; Intelligent agents; Optimal control systems; Particle swarm optimization (PSO); Stochastic control systems; Stochastic models; Stochastic programming; Hybrid genetic algorithms; Multiagent systems (MASs); Optimal controls; Parallel hybrid-genetic algorithms; Particle swarm; Particle swarm optimization; Real coded genetic algorithm; Stochastic multi-agent systems; Swarm optimization; Utility functions; Stochastic systems},
	correspondence_address = {A.S. Akopov; Central Economics and Mathematics Institute of RAS, Moscow, Russian Federation; email: andranik.s.akopov@ieee.org},
	editor = {Sergeyev, Y.D. and Kvasov, D.E. and Astorino, A. and Sergeyev, Y.D.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
