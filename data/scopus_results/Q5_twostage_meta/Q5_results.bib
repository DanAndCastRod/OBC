	keywords = {Discrete event simulation; Evolutionary algorithms; Job shop scheduling; Production efficiency; Stochastic models; Stochastic programming; Stochastic systems; Discrete-event simulations; Distributed manufacturing; Evaluation methods; Flexible job shops; Flexible job-shop scheduling; Multi-Objective Evolutionary Algorithm; Multi-objectives optimization; Simulation evaluation; Stochastic simulations; Stochastics; Multiobjective optimization},
