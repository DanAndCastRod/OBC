	title = {Robust Fuzzy-Stochastic Programming Model and Meta-Heuristic Algorithms for Dual-Resource Constrained Flexible Job-Shop Scheduling Problem under Machine Breakdown},
	year = {2021},
	journal = {IEEE Access},
	volume = {9},
