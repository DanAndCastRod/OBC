	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105015148777&doi=10.1016%2Fj.oceaneng.2025.122669&partnerID=40&md5=7777bcd536358d4818d40b52cc554865},
	affiliations = {Tsinghua University, Beijing, China; China Electric Power Research Institute, Beijing, China; China Energy Engineering Group Guangdong Electric Power Design Institute co., Ltd, Guangzhou, Guangdong, China},
	abstract = {The offshore wind power has developed dramatically in recent years. However, the harsh marine environment makes the operation and maintenance (O&M) of offshore wind farms (OWFs) exceptionally challenging, which creates substantial obstacles to the cost reduction and profitability of OWFs. An optimization method for corrective maintenance (CM) of OWF is proposed, in which the O&M activities are divided into two phases based on the decision sequence. In the first phase, a two-stage stochastic programming model is proposed to optimize the chartering scheme of vessel fleet, while the benefits of intensive O&M, namely multiple OWFs share the same set of O&M resources, are assessed, and the compatibility of different vessels in O&M activities are also considered. In the second phase, a full-ship-sharing working mode is introduced to further improve the efficiency of O&M, in which an improved vehicle routing problem with pick-up and delivery and time windows (VRPPDTW) is formulated and applied to optimize the maintenance schedule. To expedite the solution of the model, an improved genetic algorithm (GA) is designed. The effectiveness and computation efficiency of the proposed strategy and method are verified through some case studies and sensitivity analysis on the market fluctuations based on a real-world OWF in China. © 2025},
	author_keywords = {Full-ship-sharing; Improved genetic algorithm; Intensive operation and maintenance; Maintenance scheduling; Offshore wind farm},
	keywords = {Corrective maintenance; Cost reduction; Fleet operations; Genetic algorithms; Offshore oil well production; Scheduling algorithms; Shipbuilding; Ships; Stochastic models; Stochastic systems; Full-ship-sharing; Improved genetic algorithm; Intensive operation and maintenance; Maintenance activity; Maintenance scheduling; Offshore winds; Operations and maintenance; Optimization method; Wind farm; Sensitivity analysis; genetic algorithm; maintenance; offshore structure; optimization; sensitivity analysis; stochasticity; wind farm},
