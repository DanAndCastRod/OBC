@ARTICLE{ALAhmad2025,
	author = {ALAhmad, Ahmad K. and Verayiah, Renuga and Ba-swaimi, Saleh and Hussain, Shareef and Ramasam, Agileswari},
	title = {Enhancing green energy integration through strategic planning of renewable generators, EV parking lots, and stationary battery storage systems},
	year = {2025},
	journal = {Journal of Energy Storage},
