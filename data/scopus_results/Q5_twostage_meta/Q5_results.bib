	author = {Dehghan, Mohammad and Zadehbagheri, Mahmoud and Kiani, Mohammad Javad and Nejatian, Samad},
	title = {Virtual power plants planning in the distribution network constrained to system resiliency under extreme weather events},
	year = {2023},
	journal = {Energy Reports},
	volume = {9},
	pages = {4243 - 4256},
	doi = {10.1016/j.egyr.2023.03.080},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85150306281&doi=10.1016%2Fj.egyr.2023.03.080&partnerID=40&md5=7e9e62ccf38cb64e2b5ef3007c5a382c},
	affiliations = {Islamic Azad University, Yasuj Branch, Department of Electrical Engineering, Yasuj, Isfahan, Iran},
	abstract = {The present study finds the proper location and size of virtual power plants (VPPs) in distribution networks, while taking into account network resilience to severe weather conditions. This is formulated as an optimization problem with two objective functions to minimize both the planning cost of the VPPs in a year and expected energy not-supplied of the network during natural events like flood and earthquake. The problem is subject to some boundaries, including AC power flow relationships, limits on operating and resilience situation, and planning terms of the VPP. There are also uncertain quantities present in the problem, such as those related to the amount of load, renewable power generation, price of energy, and accessibility of equipment and VPP devices. The uncertainties are modeled using the stochastic programming. The two objectives are merged to be a single objective by adopting Pareto optimization based on ɛ-constraint method. Krill herd optimization (KHO) and grey wolf optimization (GWO) are also combined to introduce a new hybrid algorithm so that a dependable optimal solution that shows low dispersion. Finally, a 33-bus distribution network is used to test the validity of the proposed method. According to the result, the optimal size and site of VPPs are found and the network achieves more suitable economic, operating, and resilience indices. © 2023 The Author(s)},
	author_keywords = {Energy not-supplied; Hybrid metaheuristic algorithm; Optimal size and location; Resilience; Virtual power plant},
	keywords = {Electric load flow; Meteorology; Multiobjective optimization; Pareto principle; Stochastic programming; Stochastic systems; Virtual Power Plants; Energy; Energy not-supplied; Extreme weather events; Hybrid metaheuristic algorithms; Optimal locations; Optimal size; Optimisations; Plant planning; Resilience; Virtual power plants; Electric power distribution},
