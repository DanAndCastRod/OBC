}

@ARTICLE{Zhu2024,
	author = {Zhu, Yuhua and Fan, Xiang and Yin, Chuanzhong},
	title = {Aptenodytes forsteri optimization algorithm for low-carbon logistics network under demand uncertainty},
	year = {2024},
	journal = {PLoS ONE},
	volume = {19},
	number = {1 January},
	pages = {},
	doi = {10.1371/journal.pone.0297223},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85183882319&doi=10.1371%2Fjournal.pone.0297223&partnerID=40&md5=cc9b1e4549f762aabda841a480770f34},
	affiliations = {Shanghai Maritime University, College of Transport and Communications, Shanghai, China},
	abstract = {As China’s "double carbon" goal continues to advance, logistics as a key area of carbon emissions and low-carbon logistics center site selection are key links in the process. However, existing studies on logistics center location often ignore the impact of demand uncertainty, which leads to a waste of resources in the planning and construction processes. We take logistics cost and carbon emission as the objectives, and the multi-objective site selection model established based on stochastic programming theory takes demand uncertainty as a stochastic constraint. We transform the stochastic constraint model into a 0–1 mixed integer multi-objective planning model by utilizing the idea of equivalence transformation. The Aptenodytes Forsteri Optimization (AFO) algorithm is combined with the Ideal Point Method to solve the model, and the algorithm is compared with the Particle Swarm Optimization (PSO), Differential Evolutionary (DE), Tabu Search (TS), Sparrow Search (SS) algorithms, and the exact solver Linear Interactive and General Optimizer (LINGO). The examples verify the validity of the models and algorithms, with an average reduction of 6.2% and 3.6% in logistics costs and carbon emissions in the case of demand determination, and at the confidence level of 0.9 under demand uncertainty, both logistics costs and carbon emissions are decreased to varying degrees. This study provides a new research idea for the low-carbon logistics location problem under demand uncertainty, which helps to promote the transformation of the logistics industry to low-carbon and high-efficiency. ©: © 2024 Zhu et al.},
	keywords = {carbon; algorithm; Article; carbon emission; genetic algorithm; mathematical model; nonhuman; particle swarm optimization; process optimization; scientific literature; sensitivity analysis; simulation; stochastic model; uncertainty; validity; volume of distribution; animal; penguin; theoretical model; Algorithms; Animals; Carbon; Models, Theoretical; Spheniscidae; Uncertainty},
	correspondence_address = {X. Fan; College of Transport and Communications, Shanghai Maritime University, Shanghai, China; email: 201930610037@stu.shmtu.edu.cn},
	publisher = {Public Library of Science},
