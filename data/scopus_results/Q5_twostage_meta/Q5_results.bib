@CONFERENCE{Nourmohammadzadeh20241745,
	author = {Nourmohammadzadeh, Abtin and Voß, Stefan},
	title = {A Matheuristic Algorithm to Optimise Multi-Objective Production Scheduling in a Manufacturing Plant with Fluctuating Raw Material Supplies},
	year = {2024},
	journal = {GECCO 2024 Companion - Proceedings of the 2024 Genetic and Evolutionary Computation Conference Companion},
	pages = {1745 - 1753},
	doi = {10.1145/3638530.3664177},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85201981395&doi=10.1145%2F3638530.3664177&partnerID=40&md5=16da1fad9ce0c8e8bcc657316cf5b29f},
	affiliations = {Universität Hamburg, Institute of Information Systems, Hamburg, Hamburg, Germany},
	abstract = {Production scheduling under uncertain material supplies, a common phenomenon in practical settings, presents considerable challenges, particularly within the industrial sector. The current study defines this problem as a bi-objective right-hand-side (RHS) stochastic program aiming to minimise the overall expenses associated with production and inventory as one objective, and to reduce the cumulative adverse effects resulting from product completion delays as the other objective. A mixed-integer linear model is constructed for the problem and a matheuristic algorithm, which combines variable neighbourhood search (VNS), fixed set search (FSS), and mathematical optimisation of sub-problems, is proposed to address the intricate nature of the problem. Multiple scenarios are analysed concerning the available material supplies, and robust non-dominated solutions are sought. The efficiency of the proposed algorithm is evaluated against some alternative techniques. For instance, the ϵ-constraint method is examined separately, and a hybrid metaheuristic strategy is explored, combining the non-dominated sorting genetic algorithm (NSGA-II) with multi-objective simulated annealing (MOSA). Key performance indicators including hypervolume, quality metric, and processing time are used for evaluation. Moreover, a dynamic parameter adjustment approach is implemented, demonstrating a significant level of effectiveness. © 2024 Copyright is held by the owner/author(s). Publication rights licensed to ACM.},
	author_keywords = {dynamic parameter adjustment; multi-objective; production scheduling; right-hand-side (RHS) uncertainty; robustness; uncertain material supplies},
	keywords = {Integer linear programming; Integer programming; Multiobjective optimization; Quality control; Scheduling algorithms; Simulated annealing; Stochastic models; Dynamic parameter adjustment; Dynamic parameters; Material supply; Multi objective; Parameters adjustment; Production Scheduling; Right-hand-side uncertainty; Robustness; Uncertain material supply; Uncertainty; Stochastic programming},
	correspondence_address = {A. Nourmohammadzadeh; Institute of Information Systems, University of Hamburg, Hamburg, Germany; email: abtin.nourmohammadzadeh@uni-hamburg.de},
	publisher = {Association for Computing Machinery, Inc},
