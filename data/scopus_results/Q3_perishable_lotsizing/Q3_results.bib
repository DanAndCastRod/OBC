@CONFERENCE{Kamhuber20192108,
	author = {Kamhuber, Felix and Sobottka, Thomas and Heinzl, Bernhard and Sihn, Wilfried},
	title = {An Efficient Multi-Objective Hybrid Simheuristic Approach for Advanced Rolling Horizon Production Planning},
	year = {2019},
	journal = {Proceedings - Winter Simulation Conference},
	volume = {2019-December},
	pages = {2108 - 2118},
	doi = {10.1109/WSC40007.2019.9004902},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081133219&doi=10.1109%2FWSC40007.2019.9004902&partnerID=40&md5=79cb2eb73349ba142ce729f01c3c1dfa},
	affiliations = {Fraunhofer Austria Research GmbH, Vienna, Austria; TU Wien, Institute of Computer Engineering, Vienna, Vienna, Austria},
	abstract = {This contribution introduces an innovative holistic multi-objective simheuristic approach for advanced production planning on rolling horizon basis for an European industrial food manufacturer. The optimization combines an efficient heuristic mixed-integer optimization, followed by a customized Simulated Annealing algorithm. State-of-the-Art multi-objective solution techniques fail to address highly fluctuating demands in a suitable way. Due to the lack of modelling details, as well as dynamic constraints, these methods are unable to adapt to seasonal (off-) peaks in demand and to consider resource adjustments. Our approach features dynamic capacity and stock-level restrictions, which are evaluated by an integrated simulation module, as well as a statistical explorative data analysis. In addition to a smoothed production, mid-term stock levels, setup-costs and the expected utilization of downstream equipment are optimized simultaneously. The results show a ~ 30 to 40% reduced output variation rate, thus yielding an equally reduced requirement for downstream equipment. © 2019 IEEE.},
	keywords = {Integer programming; Planning; Production control; Simulated annealing; Downstream equipment; Dynamic constraints; Explorative data analysis; Integrated simulations; Mixed integer optimization; Resource adjustment; Simulated annealing algorithms; Solution techniques; Manufacture},
