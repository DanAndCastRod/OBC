@ARTICLE{Soler20251,
	author = {Soler, Willy Ade Oliveira and Santos, Maristela Oliveira and Akartunalı, Kerem},
	title = {Lagrangian-based heuristics for production planning with perishable products, scarce resources, and sequence-dependent setup times},
	year = {2025},
	journal = {Journal of Heuristics},
	volume = {31},
	number = {1},
	pages = {1 - 35},
	doi = {10.1007/s10732-024-09539-w},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208799953&doi=10.1007%2Fs10732-024-09539-w&partnerID=40&md5=6dec450f101dca4232e8b946f48d9acb},
	affiliations = {Universidade Federal de Mato Grosso do Sul, Institute of Mathematics, Campo Grande, MS, Brazil; Universidade de São Paulo, Sao Paulo, SP, Brazil; University of Strathclyde, Department of Management Science, Glasgow, Scotland, United Kingdom},
	abstract = {In this paper, we study a lot-sizing and scheduling problem apparent in the food industry that stemmed originally from the Brazilian meat production sector. More specifically, we consider a production environment in which various production lines share a set of scarce production resources. Therefore, only a subset of the existing production lines can simultaneously operate in each period under the limitations of the availability of resources. Moreover, we consider sequence-dependent setup times and costs, significant inventory holding costs, backlogging, and perishable products. The problem is formulated as a mixed integer programming model, and we propose four Lagrangian-based heuristics to find high-quality solutions for challenging instances. A computational study shows that proposed approaches are very competitive in solving the problem, outperforming methods already established in the literature. © The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2024.},
	author_keywords = {90C11; Lagrangian heuristic; Perishable products; Production planning; Scarce resources},
	keywords = {90c11; Lagrangian; Lagrangian heuristics; Lot sizing problems; Lot-sizing and scheduling; Perishable product; Production line; Production Planning; Scarce resources; Sequence-dependent setup time; Mixed-integer linear programming},
	correspondence_address = {W.A.O. Soler; Mathematics Institute, Universidade Federal de Mato Grosso do Sul, Campo Grande, Av. Costa e Silva s/n, MS, 79070-900, Brazil; email: willy.oliveira@ufms.br},
	publisher = {Springer},
	issn = {13811231},
	coden = {JOHEF},
	language = {English},
	abbrev_source_title = {J Heuristics},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
