	pages = {345 - 365},
	doi = {10.1080/24725854.2017.1405296},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85042100887&doi=10.1080%2F24725854.2017.1405296&partnerID=40&md5=df967e05f31d417064c6ee3f4925ab98},
	affiliations = {Shenandoah University, Jr. School of Business, Winchester, VA, United States; College of Engineering, Computing and Applied Sciences, Clemson, SC, United States; College of Engineering, Fayetteville, AR, United States},
	abstract = {This study extends classic economic lot-sizing problems to permit the replenishment of age-dependent perishable inventories via multiple transportation modes. Inventory replenishment costs include a multiple-setup cost function that considers order setup, purchase, and cargo container costs. The objective is to identify the timing of orders, order quantities, and a choice from among I transportation modes that minimizes the cost of replenishing perishable inventories during a planning horizon of length T. We present a mixed-integer programming formulation of this problem and characterize properties of optimal solutions. We propose a primal-dual heuristic algorithm that runs in O(IT<sup>2</sup>). In addition, we provide heuristic algorithms for two special cases of the problem involving one or two replenishment modes. For the single replenishment mode problem, we propose (i) a dynamic programming algorithm that explores solutions that satisfy the Zero Inventory Ordering Policy and runs in O(T<sup>2</sup>) and (ii) a dynamic programming algorithm that explores solutions that satisfy the Less-than-Truckload first positioning property and runs in O(T<sup>3</sup>). For the two replenishment mode problem, we present a knapsack-based algorithm that identifies the minimum number of cargo containers required to meet demand. The running time of this algorithm is O(T<sup>2</sup>). We evaluate the quality of the solutions generated by these different approaches via extensive numerical analyses. © © 2018 “IISE”.},
	author_keywords = {Economic lot sizing; multimode replenishment; multiple-setup cost structure; perishable inventories; primal-dual algorithm},
	keywords = {Containers; Cost functions; Costs; Dynamic programming; Integer programming; Multimodal transportation; Transportation; Lot sizing; Multimodes; Perishable inventory; Primal dual algorithms; Setup costs; Heuristic algorithms},
