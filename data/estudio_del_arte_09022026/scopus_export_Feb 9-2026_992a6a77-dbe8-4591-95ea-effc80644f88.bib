@ARTICLE{El Fartassi2026,
	author = {El Fartassi, Imane and Sharp, Ryan T. and Bell, V. A. and Whitmore, Andrew Peter and Metcalfe, Helen and Missault, Nathan and Redhead, John W. and Cooper, David M. and Storkey, Jonathan and Davies, Helen N. and Jackson, Theo and Coleman, Kevin W. and Milne, Alice E.},
	title = {Rethinking land-use Strategies: A multi-objective analysis of combined sparing and sharing approaches applied across great britain},
	year = {2026},
	journal = {Journal of Environmental Management},
	volume = {398},
	pages = {},
	doi = {10.1016/j.jenvman.2025.128389},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105025760327&doi=10.1016%2Fj.jenvman.2025.128389&partnerID=40&md5=3b46326f4211c6b12765f8b00265d770},
	abstract = {The land-sharing versus land-sparing debate represents a critical juncture in agricultural policy development. However, applying either of these approaches uniformly at a national scale has been challenged suggesting that more effective strategies may require a context-dependent mix of methods. This study evaluates plausible strategies of land sparing and land sharing at regional scale in Great Britain using the Long-Term Large Scale integrated modelling framework. We consider these strategies in various combinations to get national scale outcomes for nutrient losses to freshwater and agricultural productivity. By simulating various land-use configurations across 11 International Territorial Level regions, we generated over 1.79 trillion scenarios with differing regional distributions of arable and semi-natural land. We used multiple objective optimization to find an optimal solution set. Our analysis identified 24,412 Pareto-optimal solutions that also improved on business-as-usual. The Pareto-optimal solutions all favoured combining land-sparing and land-sharing approaches. These optimized scenarios achieved increases of up to 9.7 % in livestock calories and 5.2 % in crop calories, while reducing phosphorus losses by 6.9 % and nitrate losses by 11.9 % in comparison to a business-as-usual scenario. Our findings demonstrate that spatially differentiated land-use strategies tailored to regional characteristics outperform uniform national sharing or sparing approaches. However, these modest improvements suggest that transformative change will require complementary innovations beyond land allocation strategies alone. This approach advances landscape planning from binary sharing-sparing debates towards a multidimensional optimization of food production and environmental quality that acknowledges the inherent complexity of dynamic landscapes while supporting evidence-based agricultural policy development. © 2025 The Authors},
	author_keywords = {Agricultural and seminatural land use; Hydrological modelling; Land management change; Macronutrients; Pareto-optimal; water quality},
	keywords = {Agriculture; Land use; Multiobjective optimization; Nutrients; Optimal systems; Agricultural and seminatural land use; Agricultural policies; Great Britain; Hydrological models; Land management change; Land managements; Land-use strategies; Macronutrient; Pareto-optimal; Policy development; Pareto principle; carbon; fertilizer; fresh water; ground water; nitrate; phosphorus; soil organic matter; soil water; agricultural policy; environmental quality; food production; hydrological modeling; land management; land use; landscape planning; livestock; multiobjective programming; water quality; agricultural land; Article; cluster analysis; commercial phenomena; correlation analysis; environmental sustainability; evidence based practice; fertilizer application; food industry; grazing; harvest; human; hydrology; lake; landscape; macronutrient; multiobjective optimization; river; sand; simulation; sustainable agriculture; water contamination; weather; agriculture; animal; environmental protection; procedures; United Kingdom; Animals; Conservation of Natural Resources; Phosphorus},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Accepted Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Ahemad2026,
	author = {Ahemad, Faizan and Kannan, Devika and Khan, Ahmad Zaman and Gupta, Pankaj and Mehlawat, Mukesh Kumar and Aggarwal, Usha},
	title = {Optimizing sustainable transportation planning for perishable goods: A two-stage fuzzy approach with route selection},
	year = {2026},
	journal = {Research in Transportation Business and Management},
	volume = {64},
	pages = {},
	doi = {10.1016/j.rtbm.2025.101537},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018872527&doi=10.1016%2Fj.rtbm.2025.101537&partnerID=40&md5=b2caf39acc91606ebf82059c22668449},
	abstract = {To address the growing need for environmentally responsible logistics, this paper proposes a two-stage fuzzy transportation planning framework aimed at promoting the sustainable distribution of perishable goods. The framework integrates route selection with multi-objective optimization to balance economic efficiency, environmental impact, and service quality. In the first stage, products are transported from manufacturers to distributors, followed by last-mile deliveries to retail outlets using small-capacity vehicles. Given the highly perishable nature of these items, timely and efficient delivery is essential to minimize spoilage, reduce resource waste, and lower greenhouse gas (GHG) emissions, all of which are critical to advancing sustainability in cold-chain logistics. To address the imprecision and uncertainty in real-world logistics, Coherent Triangular Fuzzy Numbers (CTFNs) are used to model transportation costs, delivery times, demand, supply capacities, and GHG emissions per unit time by the transporting vehicles. Fuzzy TOPSIS is applied to compute preference scores for alternative transportation routes in both stages of the distribution process based on multiple qualitative and quantitative criteria. These stage-wise preference scores are then embedded into a multi-objective optimization model that simultaneously minimizes total transportation cost and GHG emission, while enhancing service quality by maximizing total route preference score under realistic operational constraints. The proposed model is solved using a weighted sum approach and validated through a real-world case study of a bakery supply chain in Delhi, India. Results demonstrate improved distribution efficiency, reduced environmental impact, and enhanced resilience of perishable goods logistics under uncertainty. The findings also highlight the value of embedding TOPSIS-based route evaluation into the optimization model to align transportation strategies with qualitative performance metrics. Overall, the integration of fuzzy decision-making with multi-objective optimization provides a scalable and interpretable tool for sustainable transportation planning. © 2025 Elsevier Ltd},
	author_keywords = {Coherent fuzzy number; Fuzzy TOPSIS; Fuzzy transportation problem; Multi-objective optimization; Perishable goods; Route selection},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Mizrak2025,
	author = {Mizrak, Associate Prof Filiz and Cantürk, Assistant Prof Serkan},
	title = {Strategic multi-criteria assessment for cold chain logistics optimization in the aviation sector},
	year = {2025},
	journal = {Research in Transportation Business and Management},
	volume = {63},
	pages = {},
	doi = {10.1016/j.rtbm.2025.101500},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014517528&doi=10.1016%2Fj.rtbm.2025.101500&partnerID=40&md5=b0c8fd4d7fe013518f9790bea54559c7},
	abstract = {Aviation cold chain logistics forms the focus of this study, which introduces a novel hybrid multi-criteria decision-making (MCDM) framework for optimizing sustainable operations, uniquely integrating the newly developed Multi-Objective Seagull–Moth–Salp Swarm Algorithm (MO-SMSA) with K-Means clustering and the Preference Ranking Organization Method for Enrichment Evaluations (PROMETHEE). By explicitly addressing the simultaneous demands of sustainability, cost efficiency, operational feasibility, regulatory compliance, and technological integration, the research fills a critical methodological gap in aviation logistics optimization. Qualitative thematic analysis of expert interviews uncovers persistent industry challenges, including the cost–sustainability trade-off, high capital requirements for advanced technology adoption, and regulatory asymmetries across international markets. The methodology applies rigorous data preprocessing and min–max normalization to ensure reproducibility, clusters solutions into efficiency-driven, sustainability-oriented, and technology-enhanced categories, and then employs PROMETHEE to prioritize alternatives, with AI-driven predictive maintenance emerging as the leading solution. The novelty of MO-SMSA lies in its ability to dynamically adapt to shifting decision-maker priorities through scenario analysis and sensitivity testing, capturing complex trade-offs under diverse operational contexts such as high-demand vaccine distribution and general perishable goods transport. Results demonstrate that combining AI, IoT-enabled monitoring, and sustainable packaging yields the most balanced gains in efficiency, environmental performance, and compliance readiness. This study advances the literature by introducing a replicable, practitioner-friendly decision-support model that leverages a cutting-edge optimization algorithm, offering actionable insights for logistics managers, policymakers, and sustainability advocates seeking to strengthen resilience and competitiveness in aviation cold chain operations. © 2025 Elsevier Ltd},
	author_keywords = {Artificial intelligence in logistics; Aviation cold chain logistics; K-means clustering; Multi-criteria decision-making; PROMETHEE; Sustainable logistics strategies},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Bind2025,
	author = {Bind, Awdhesh Kumar and Rani, Deepika Sandhya and Ebrahimnejad, Ali},
	title = {A study of the hesitant fuzzy aggregation operators for the transportation of perishable goods under real life scenarios},
	year = {2025},
	journal = {Applied Soft Computing},
	volume = {184},
	pages = {},
	doi = {10.1016/j.asoc.2025.113668},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012928365&doi=10.1016%2Fj.asoc.2025.113668&partnerID=40&md5=ee4a6f7f87ab1b7932c22285e5cfa1a2},
	abstract = {The transportation of the perishable goods has always been a critical challenge in the market. The inherent susceptibility of the perishable items to spoilage and deterioration during transit necessitates the development and implementation of the preservation technologies that enhance the shelf life and maintain the quality of perishable products during transportation. Also, the carbon emissions stemming from activities associated with transportation present a significant and progressively urgent challenge, markedly contributing to environmental degradation. Consequently, the escalating carbon emissions linked to the transportation-related activities pose a threat to the sustainability of the environment. Recalling these facts, this paper explores the study of an interval valued multi-objective fixed charge solid transportation problem under hesitant fuzzy aggregation operators. Furthermore, this paper introduces a practical mathematical framework designed to represent the decision-making process inherited in the transportation scenarios. The proposed method leverages the hesitant fuzzy aggregation operators to offer a specific approach for the decision-making across such operators. Additionally, it introduces the notion of hesitant degrees for different objectives through the utilization of membership functions. Three conflicting objective functions: time minimization for customer satisfaction, profit maximization for the economic sustainability and minimization of the carbon emissions for the environmental sustainability have been addressed in the suggested model. The transportation time and the fuel consumption have been managed by introducing a variable called the vehicle speed coefficient. An analysis of the deterioration rates of the perishable products has been conducted considering the presence of a preservation value. Moreover, the proposed model has been formulated by employing the diverse approaches and have been solved using multi-objective techniques. A real-life-based numerical problem is presented and solved to validate the proposed concept. The results are compared with respect to different vehicle speeds and preservation values. © 2025 Elsevier B.V.},
	author_keywords = {Interval valued; Multi-objective programming techniques; Multi-objective transportation problem; Preservation value},
	keywords = {Agglomeration; Carbon; Customer satisfaction; Decision making; Deterioration; Multimodal transportation; Multiobjective optimization; Sustainable development; Carbon emissions; Fuzzy aggregation operators; Interval-valued; Multi objective; Multi-objective programming techniques; Multi-objective transportation problems; Perishable goods; Perishable product; Preservation value; Vehicle speed; Membership functions},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chan2025,
	author = {Chan, Aaron C. and Cruz, Dennis E. and Sy, Charlle L.},
	title = {A multi-objective optimization approach for the design of circular supply chains of perishable agricultural products},
	year = {2025},
	journal = {Cleaner Waste Systems},
	volume = {12},
	pages = {},
	doi = {10.1016/j.clwas.2025.100347},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010294169&doi=10.1016%2Fj.clwas.2025.100347&partnerID=40&md5=2387838def8a3555f4afcfc395d89bc4},
	abstract = {The agricultural supply chain is a critical field of investigation, particularly due to its significant role in supporting various economies. Globally, a large proportion of annual production ends up as waste, which poses not only an economic threat but also an environmental one. Recent studies have applied circular economy concepts from modular supply chains to perishable supply chains, aiming to valorize the substantial waste generated in these systems. However, these studies often treat post-harvest waste and by-products as interchangeable, failing to recognize the potential profit differences between them. This simplification risks leading to suboptimal decisions in waste recovery strategies, as it does not consider all available options. Consequently, this limitation restricts the design of a more sustainable supply chain. Furthermore, these studies oversimplify essential characteristics of agricultural supply chains, such as seasonality and perishability, undermining the accuracy and timeliness of decision-making processes. Ignoring these factors diminishes the model's realism and the practicality of the suggested actions regarding timing, degradation, and storage. To address these gaps, this study adopts a general model development approach, proposing a multi-objective mixed-integer non-linear programming model for a circular supply chain focused on fresh products. The findings highlight that the limited seasonality of fresh products can lead to a decline in product quality when delivering to end consumers, considering both economic and environmental goals. Additionally, expanding the CE scope and incorporating a broader consideration of by-products and cascading flows yield benefits in curbing potential environmental waste outflows. Finally, the implementation of circular economy approaches can serve as a safety net to protect the triple bottom line, ensuring social, economic, and environmental objectives are maintained. © 2025 The Authors},
	author_keywords = {Circular economy; Multi-objective optimization; Planting and harvesting planning; Shelf life; Sustainability},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Bayani Majd2025,
	author = {Bayani Majd, Amir and Hajavi Seydlari, Giti and Yaghoubi, Saeed},
	title = {A GIS-based food-energy-water-health-pollution nexus for sustainable food-biofuel-bioenergy supply chain network design: A case study},
	year = {2025},
	journal = {Energy},
	volume = {328},
	pages = {},
	doi = {10.1016/j.energy.2025.136371},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005289478&doi=10.1016%2Fj.energy.2025.136371&partnerID=40&md5=e25b7d0473d0b8df1f07544b5c575133},
	abstract = {Food supply chains significantly influence environmental sustainability and public health due to high energy use, emissions, and waste generation. Existing studies rarely integrate food supply chains with biofuel and bioenergy production, especially considering resource constraints and health outcomes. This paper addresses this gap by proposing a novel two-phase method for designing and optimizing a sustainable hybrid food-biofuel-bioenergy supply chain, incorporating the food-energy-water-health-pollution nexus. In the first phase, optimal locations for cultivating biomass resources (Jatropha and Microalgae) are determined using fuzzy methods within a Geographic Information System. The second phase develops a multi-objective mathematical optimization model that is solved by the Lp-metric method and validated through real-world data from Iran's food industry. The proposed network emphasizes sustainability through circular bio-economy practices, including wastewater recycling, food waste utilization, and replacing gasoil with biodiesel (20 % biodiesel, 80 % gasoil). Quantitative results demonstrate a 43 % reduction in greenhouse gas emissions, annual food products health improvements of 4 %, and efficient water resource management limiting increased water consumption to just 7 %. The network becomes profitable within seven years, with over 50 % of bioenergy derived from waste-based biomass. These innovations offer actionable insights for policymakers and managers pursuing integrated, sustainable solutions to enhance environmental performance, public health, and energy resilience. © 2025 Elsevier Ltd},
	author_keywords = {Biofuel supply chain; Circular bio-Economy; Food health; Food supply chain; Geographic information system; Nexus},
	keywords = {Waste management; Water management; Bioenergy supplies; Biofuel supply chains; Case-studies; Circular bio-economy; Energy; Food health; Food supply chain; Geographic information; Nexus; Supply chain network design; Multiobjective optimization; bioenergy; biofuel; circular economy; food supply; food waste; GIS; public health; resource management; supply chain management; wastewater treatment; water resource; Iran},
	type = {Article},
