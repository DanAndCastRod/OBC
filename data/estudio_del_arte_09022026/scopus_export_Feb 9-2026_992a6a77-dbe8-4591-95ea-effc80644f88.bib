	title = {MULTI-OBJECTIVE OPTIMIZATION FOR SUSTAINABLE VEHICLE ROUTING PROBLEM UNDER UNCERTAINTY USING THE LAGRANGIAN RELAXATION ALGORITHM-CASE: FOOD INDUSTRY COMPANY},
	year = {2024},
