@ARTICLE{Tirkolaee2022,
	author = {Tirkolaee, Erfan Babaee and Aydın, Nadi Serhan},
	title = {Integrated design of sustainable supply chain and transportation network using a fuzzy bi-level decision support system for perishable products},
	year = {2022},
	journal = {Expert Systems with Applications},
