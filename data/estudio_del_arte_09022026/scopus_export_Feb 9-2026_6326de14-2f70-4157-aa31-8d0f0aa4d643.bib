@CONFERENCE{Prabhu20247,
	author = {Prabhu, K. and Vijayachitra, S. and Mukila, D. and Mukesh, L. B. and Nithesraj, G.},
	title = {Design and Development of Pelletizer Automation using Load Control},
	year = {2024},
	journal = {Proceedings of the 5th International Conference on Smart Electronics and Communication, ICOSEC 2024},
	pages = {7 - 14},
	doi = {10.1109/ICOSEC61587.2024.10722053},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209893364&doi=10.1109%2FICOSEC61587.2024.10722053&partnerID=40&md5=fde145b97c9a064d0cab83b3c3070e3c},
	abstract = {This research study aims to design and implement an advanced automation system for pelletizers, integrating load control technology to optimize pellet production processes. Pelletizers are widely used in industries such as agriculture, food processing, and pharmaceuticals for converting raw materials into uniform pellets. However, traditional pelletizer systems often lack precise control over load conditions, leading to inefficiencies, inconsistencies, and potential equipment damage. Incorporation of load sensors into the pelletizer system to monitor the load exerted on the pelletizing blades or rollers in real-time. Load sensors will provide accurate feedback on the compression force applied during the pelletization process, enabling precise control and adjustment of pelletizer parameters. Implementation of an intuitive current rating and load to facilitate the controlled automation of pelletizing motors. A controller will provide operators with control options, real-time monitoring of load conditions, status updates, and alarm notifications, ensuring ease of operation and troubleshooting. Development of intelligent control logic and algorithms to optimize pelletization parameters dynamically based on load feedback and quality requirements. The proposed system will be capable of adjusting process parameters in real-time to accommodate variations in raw material properties and production conditions. Incorporation of data logging capabilities to record key process parameters, load profiles, and production metrics over time. Data analysis tools will enable performance evaluation, process optimization, and predictive maintenance scheduling. the paper aims to demonstrate the feasibility and advantages of integrating load control technology into pelletizer systems, leading to enhanced efficiency, precision, and safety in pellet production processes. © 2024 IEEE.},
