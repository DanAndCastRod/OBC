	title = {Optimization of battery swapping station for electric vehicles by novel adaptive GWO algorithm},
	year = {2025},
	journal = {Energy},
	volume = {333},
	pages = {},
	doi = {10.1016/j.energy.2025.137348},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009693774&doi=10.1016%2Fj.energy.2025.137348&partnerID=40&md5=b671d9903bef265270686a7084a23771},
	abstract = {This paper presents a novel approach for optimising the scheduling of battery charging in battery swapping stations (BSS) to enhance their profitability. A multi-objective optimization model is developed to maximise the net profit of the BSS while maintaining a high quality of service for electric vehicle (EV) users. In the proposed framework, EVs can act both as battery consumers and providers. To solve this optimization problem, we employ a Novel Adaptive Grey Wolf Optimization (AGWO) algorithm that dynamically adjusts to system changes to iteratively determine optimal charging schedules. The model incorporates various realistic constraints, including battery state of charge (SOC), energy balance, customer satisfaction thresholds, battery inventory levels, and financial exchanges, while accounting for dynamic electricity pricing and stochastic EVs arrival rates. The proposed algorithm is implemented and validated in MATLAB Simulink. To evaluate the performance of the proposed Novel AGWO algorithm, a case study is conducted for an urban area in Patna district, Bihar, India (25.590° N, 85.110° E), where a centralized solar-powered Battery Storage System (BSS) is considered as a replacement for smaller distributed charging stations within a 10 km radius. The simulation results demonstrate that the AGWO algorithm outperforms existing methods, including Particle Swarm Optimization (PSO), Harris Hawk Optimization (HHO), Cuckoo Search Optimization (CSO), and Chicken Swarm Algorithm (CSA). Specifically, AGWO achieves the highest average profit (94.556 %) and converges in approximately 60 iterations, faster than the competing algorithms. Additionally, AGWO exhibits superior battery stock management and scheduling efficiency under dynamic and uncertain system conditions. This research contributes to the advancement of sustainable transportation systems by providing a practical and efficient solution for optimising battery charging in Battery Swapping Stations (BSS), thereby promoting the widespread adoption of electric vehicles. © 2025},
	author_keywords = {Battery charging; Battery swapping station; Electric vehicles; Grew wolf optimization},
	keywords = {Automotive batteries; Battery management systems; Battery storage; Charging (batteries); Charging stations; Customer satisfaction; Electronic trading; Financial markets; Iterative methods; Multiobjective optimization; Profitability; Quality of service; State of charge; Stochastic models; Stochastic systems; Battery swapping; Battery swapping station; Gray wolves; Grow wolf optimization; High quality; Multi-objective optimization models; Net profits; Optimisations; Optimization algorithms; Quality-of-service; Electric vehicles; Particle swarm optimization (PSO); algorithm; battery; electric vehicle; electricity generation; energy market; optimization; simulation; urban area; Bihar; India; Patna},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@ARTICLE{Tahraoui20251581,
	author = {Tahraoui, Nacera and Triqui, Lamia and Bennekrouf, Mohammed},
	title = {Operational planning of the production and the processing of chickens in multi-products slaughter unit},
	year = {2025},
	journal = {OPSEARCH},
	volume = {62},
	number = {3},
	pages = {1581 - 1615},
	doi = {10.1007/s12597-024-00846-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202847076&doi=10.1007%2Fs12597-024-00846-1&partnerID=40&md5=2b746f5977281340ee0337f89e4c9fa7},
	abstract = {This research studies the production planning of a charcuterie unit that slaughters animal products from poultry, cattle, and sheep farming and processes them into multiple products. The current organization of this unit was carried out in an anarchic manner without prior study or optimization, resulting in significant malfunctions and a high rate of unsatisfied product demands. To reduce this rate, an original contribution was developed based on modeling under realistic constraints, considering the fluctuations in demand over a 1-year planning horizon. An integrated approach was taken, which involved considering several considerations, such as additive production capabilities from overtime or hiring a seasonal team, while respecting the ergonomic aspects of workers in both situations. The obtained results are significantly better than those of the previous organization. This decision-making tool presents a generic model that can be applied to other case studies and has demonstrated its effectiveness in choosing the work mode and determining the optimal quantities of fresh, deep-frozen, and by-product products. The proposed approach has also proven effective in controlling energy consumption at the storage tunnels and providing careful control at the beginning and end of each period. In the end, the developed model was validated with the Cplex solver in a multi-product, multi-period environment, considering several obstacles that translated into constraints. From the modeling point of view, this study can be a valuable resource for the development and extension of other similar cases. © The Author(s), under exclusive licence to Operational Research Society of India 2024.},
	author_keywords = {Multi-product; Operational planning; Poultry supply chain; Production planning},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

