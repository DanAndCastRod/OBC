@ARTICLE{Wei2025124,
	author = {Wei, Tingting and Guo, Xiwang and Zhou, Mengchu and Wang, Jiacun and Liu, Shixin and Qin, Shujin and Tang, Ying},
	title = {A Multiobjective Discrete Harmony Search Optimizer for Disassembly Line Balancing Problems Considering Human Factors},
	year = {2025},
	journal = {IEEE Transactions on Human-Machine Systems},
	volume = {55},
	number = {2},
	pages = {124 - 133},
	doi = {10.1109/THMS.2025.3528629},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002037596&doi=10.1109%2FTHMS.2025.3528629&partnerID=40&md5=8c954a7583733337620c9e60b14b1183},
	abstract = {Ecological environment and natural resource issues are becoming more and more prominent, which promotes the recycling of waste products for green economy. Disassembly plays a key role in the remanufacturing and reuse of waste products. However, with the rapid development of production automation, designers tend to ignore the fact that manual operation is more flexible. It is of great importance to consider human factors in a disassembly process. This work considers two human disassembly postures, namely standing and sitting. The multiobjective disassembly line balancing problem considering human posture changes is studied. A mathematical model with the objective functions of maximizing profit, minimizing the number of posture changes at a workstation, and minimizing the difference of maximum posture changes between any two workstations is established. The model is solved through a newly proposed Pareto-based discrete harmony search algorithm. Three neighborhood structures are designed to enlarge the search space for better solutions. Furthermore, an elite reserve strategy is used to improve the global optimization ability of the proposed algorithm. Finally, the proposed model and algorithm are applied to cases of different scales of complexities, and the effectiveness of the proposed model and algorithm is verified in comparison with four competitive algorithms. © 2013 IEEE.},
	author_keywords = {demanufacturing systems; Disassembly line balancing (DLB); harmony search (HS); human factor; optimization; stochastic simulation; sustainable development},
	keywords = {Multiobjective optimization; Stochastic models; De-manufacturing system; Disassembly line balancing; Discrete harmony searches; Harmony search; Line balancing problem; Multi objective; Optimisations; Stochastic simulations; Stochastic systems},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@ARTICLE{Wu2024,
	author = {Wu, Tengfei and Zhang, Zeqiang and Guo, Lei and Song, Haoxuan and Xie, Xinlan and Ren, Shiyi},
	title = {A hybrid evolutionary algorithm for the stochastic human–robot collaborative disassembly line balancing problem considering carbon emission optimization},
	year = {2024},
	journal = {Engineering Applications of Artificial Intelligence},
	volume = {135},
	pages = {},
	doi = {10.1016/j.engappai.2024.108703},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195192607&doi=10.1016%2Fj.engappai.2024.108703&partnerID=40&md5=cd271b214102feaabb85a45db9c410e2},
	abstract = {To drive a paradigm shift towards a human-centric approach in remanufacturing systems and promote energy-efficient, carbon-reduction-friendly upgrades, this paper introduces a stochastic human–robot collaborative disassembly line balancing problem for real-world disassembly lines characterized by uncertain operation times. The developed mathematical model takes into account task priority relationships, task attributes, human–robot collaboration, and cycle time constraints, with the goal of optimizing workstation numbers, smoothing indices, and carbon emissions. Subsequently, we propose a hybrid evolutionary algorithm (HEA) to efficiently address this problem. The algorithm includes methods for generating initial solutions and decoding them based on random disassembly time. Additionally, an enhanced differential evolution operation is integrated into the non-dominated sorting genetic algorithm II (NSGA-II) framework to improve the algorithm's evolutionary and search capabilities. Validation experiments involving 21 benchmark cases demonstrate that HEA significantly outperforms seven other algorithms reported in the existing literature. Finally, the proposed algorithm is applied to a printer case comprising 55 components. The results underscore the algorithm's superior search capabilities compared to the innovative hybrid algorithm, genetic simulated annealing algorithm, as well as traditional NSGA-II and evolutionary algorithms, under both low and high randomness conditions. © 2024 Elsevier Ltd},
	author_keywords = {Carbon emission optimization; Disassembly line balancing problem; Evolutionary algorithm; Human–robot collaborative; Stochastic disassembly time},
	keywords = {Carbon; Genetic algorithms; Robots; Simulated annealing; Stochastic systems; Carbon emission optimizations; Disassembly line balancing; Disassembly line balancing problem; Disassembly time; Human robots; Human–robot collaborative; Hybrid evolutionary algorithm; Line balancing problem; Stochastic disassembly time; Stochastics; Energy efficiency},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 11}
}

@ARTICLE{Chu2024,
	author = {Chu, Mengling and Chen, Weida},
	title = {Multi-manned disassembly line balancing problems for retired power batteries based on hyper-heuristic reinforcement},
	year = {2024},
	journal = {Computers and Industrial Engineering},
	volume = {194},
	pages = {},
	doi = {10.1016/j.cie.2024.110400},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199289186&doi=10.1016%2Fj.cie.2024.110400&partnerID=40&md5=0a23118e657706828125ac4d43c53af9},
	abstract = {Considering the complexity and uncertainty of retired power batteries, worker disassembly can reduce the cost and increase the flexibility of the disassembly process. To address the problem of considerable waste products, we investigate a multi-manned disassembly line balancing problem with different work modes (MWM-DLBP). In addition, we explore the impact of variability in penalizing factors (earliness and tardiness) on costs when products of different scales need to be disassembled. Given the NP-hard of the problem and unpredictable situations, we propose a reinforcement learning-based Hyper-Heuristics (RLHHs) algorithm to solve the practical issues. A Markov model is constructed to generate a sequence of low-level metaheuristic algorithms, and a multi-armed bandit (MAB) method is designed to tune different critical parameters intelligently. The superiority of RLHHs is verified by comparing the optimization results with other algorithms. Further, results reveal that the new disassembly scheme can save an average cost of 9.81% compared to the original system design. Finally, we provide manufacturers with the specific workforce planning and working mode for disassembly tasks under different scenarios. © 2024 Elsevier Ltd},
	author_keywords = {Disassembly line balancing; Hyper-heuristics; Multi-manned workstations; Reinforcement learning; Retired power batteries},
	keywords = {Electric batteries; Heuristic methods; Markov processes; Disassembly line balancing; Disassembly process; Hyper-heuristics; Line balancing problem; Multi-manned workstation; Power batteries; Reinforcement learnings; Retired power battery; Uncertainty; Workers'; Reinforcement learning},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 13}
}

