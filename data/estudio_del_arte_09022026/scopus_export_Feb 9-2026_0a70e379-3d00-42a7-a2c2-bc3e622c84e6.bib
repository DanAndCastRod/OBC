	doi = {10.1016/j.engappai.2025.110211},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217898487&doi=10.1016%2Fj.engappai.2025.110211&partnerID=40&md5=d596170b6569bb733146bfafc923fbf3},
	abstract = {With the accelerated upgrading of mechanical products, the impact of end-of-life (EOL) products on the environment is gradually increasing. Therefore, disassembly and recycling have gradually become hot spots for environmental protection and sustainable manufacturing. The U-shaped disassembly line has better advantages over the linear disassembly line in terms of disassembly task allocation, workstation balancing and disassembly line layout, which is challenging research. when the EOL products seriously deform and fail, the disassembly time is difficult to predict, which will cause disassembly failure and the disassembly line shutdown will affect the production. Moreover, If the uncertainty in the U-shaped disassembly line balancing problem (U-DLBP) are not considered, which ultimately leads to the result deviation from the actual situation. Therefore, this paper proposes an U-DLBP framework to deal with the uncertain U-DLBP and quantify the disassembly risk. an interval type-2 trapezoidal fuzzy set (IT2TFS) was introduced as a modelling tool for uncertain analysis, risk quantification, and improving the accuracy in U-DLBP. An IT2TFS-based U-DLBP mathematical model combining average smoothness, disassembly cost and disassembly energy consumption was constructed. In response to the complexity of the problem, an improved fuzzy multi-objective particle swarm optimization algorithm (FMOPSO) inspired by genetic operators was developed to avoid premature convergence and improving global optimization ability. According to the case study of EOL printer, the performance of the improved FMOPSO algorithm is significantly better than other three algorithms in stability and convergence when solving a practical case. The results confirm that this research provides an effective tool to solve the problem of the IT2TFS-based U-DLBP and some reference gist for designers. © 2025 Elsevier Ltd},
	author_keywords = {Average smoothness; Disassembly energy consumption; Intelligent optimization; Interval type-2 trapezoidal fuzzy set; U-shaped disassembly line balancing},
	keywords = {Fuzzy set theory; Fuzzy sets; Multiobjective optimization; Particle swarm optimization (PSO); Risk analysis; Risk assessment; Average smoothness; Disassembly energy consumption; Disassembly line balancing; Energy-consumption; Intelligent optimization; Interval type-2 trapezoidal fuzzy set; Line balancing problem; Trapezoidal fuzzy sets; U-shaped; U-shaped disassembly line balancing; Global optimization},
