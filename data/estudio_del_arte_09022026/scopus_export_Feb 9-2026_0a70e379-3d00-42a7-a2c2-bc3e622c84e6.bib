	author = {Guo, Xiwang and Fan, Chenyang and Zhou, Mengchu Chu and Liu, Shixin and Wang, Jiacun and Qin, Shujin and Tang, Ying Gina},
	title = {Human-Robot Collaborative Disassembly Line Balancing Problem with Stochastic Operation Time and a Solution via Multi-Objective Shuffled Frog Leaping Algorithm},
	year = {2024},
	journal = {IEEE Transactions on Automation Science and Engineering},
