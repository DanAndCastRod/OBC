}

@CONFERENCE{Yang2025489,
	author = {Yang, Zhongyuan and Zhai, Weiwei and Xu, Xiaowei and Shi, Shuo and Xu, Yanping and Shi, Ruohong},
	title = {FQ-EMCI-Net: A Multi-Head Attention CNN-DQN Approach with Filtered Q-Learning and Equilibrium Monte Carlo Initialization for SP-DLBP},
	year = {2025},
	journal = {10th International Conference on Image, Vision and Computing, ICIVC 2025},
