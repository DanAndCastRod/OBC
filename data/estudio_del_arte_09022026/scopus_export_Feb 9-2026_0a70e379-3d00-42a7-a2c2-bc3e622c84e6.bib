@CONFERENCE{Xu20201,
	author = {Xu, Chengcheng and Wei, Haiping and Guo, Xiwang and Liu, Shixin and Qi, Liang and Zhao, Ziyan},
	title = {Human-Robot Collaboration Multi-objective Disassembly Line Balancing Subject to Task Failure via Multi-objective Artificial Bee Colony Algorithm},
	year = {2020},
	journal = {IFAC-PapersOnLine},
	volume = {53},
	number = {5},
	pages = {1 - 6},
	doi = {10.1016/j.ifacol.2021.04.076},
