@CONFERENCE{Fang2020,
	author = {Fang, Yilin and Zhang, Hanke and Liu, Quan and Zhou, Zude and Yao, Bitao and Pham, D. T.},
	title = {Interval multi-objective evolutionary optimization for disassembly line balancing with uncertain task time},
	year = {2020},
	journal = {ASME 2020 15th International Manufacturing Science and Engineering Conference, MSEC 2020},
	volume = {2},
	pages = {},
